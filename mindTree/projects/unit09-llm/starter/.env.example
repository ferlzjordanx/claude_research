# Copy to .env for local development. Never commit real keys.
APP_ENV=dev
# fake | anthropic | openai  (fake needs no key and no network)
APP_LLM_PROVIDER=fake

# Anthropic (Claude). Default model: claude-opus-5-5
APP_ANTHROPIC_API_KEY=
APP_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI. Pick a model ID from platform.openai.com/docs/models.
# There is deliberately no default: the app refuses to start
# with provider=openai and an empty model.
APP_OPENAI_API_KEY=
APP_OPENAI_MODEL=

# Call policy
APP_LLM_TIMEOUT_S=20
APP_LLM_MAX_RETRIES=2
APP_LLM_BACKOFF_BASE_S=0.5
APP_CONFIDENCE_THRESHOLD=0.6

# EXAMPLE prices in USD per million tokens (not authoritative:
# check the provider pricing page). JSON: {"model": [in, out]}
# APP_PRICES={"claude-opus-5-5": [4.0, 20.0]}
