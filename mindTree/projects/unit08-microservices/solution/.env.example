# Copy to .env for local runs. Both services read APP_* variables;
# each one ignores the settings it does not know.
APP_ENV=dev

# --- orders (port 8000) ---
APP_DATABASE_URL=sqlite:///./orders.db
APP_PAYMENTS_URL=http://127.0.0.1:8001
APP_PAYMENTS_TIMEOUT_S=2.0
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_BASE_DELAY_S=0.2
APP_RETRY_MAX_DELAY_S=2.0
APP_RETRY_AFTER_CAP_S=5.0
APP_BREAKER_FAILURE_THRESHOLD=5
APP_BREAKER_RESET_TIMEOUT_S=30
APP_BACKGROUND_WORKERS=true
APP_WORKER_INTERVAL_S=1.0

# --- payments (port 8001) ---
APP_FAULT_ERROR_RATE=0.0
APP_FAULT_LATENCY_MS=0
APP_FAULT_HEADER_ENABLED=true
APP_DECLINE_OVER_CENTS=100000
