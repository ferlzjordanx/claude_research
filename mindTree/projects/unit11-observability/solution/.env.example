# Copy to .env for local development. Never commit real secrets.
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=sqlite:///./orders.db
APP_FX_BASE_URL=http://127.0.0.1:9000
APP_FX_TIMEOUT_SECONDS=2.0
APP_RENDER_DELAY_SECONDS=0.2
# none | console | otlp
APP_OTEL_EXPORTER=console
# Read by the OTLP exporter itself when APP_OTEL_EXPORTER=otlp:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
