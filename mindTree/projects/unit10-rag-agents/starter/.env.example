# Copy to .env for local development. Never commit real secrets.
APP_ENV=dev
# fake (default, offline) | anthropic | openai
APP_PROVIDER=fake
APP_ANTHROPIC_MODEL=claude-opus-5-5
# Required only when APP_PROVIDER=openai. Take the model ID from
# https://platform.openai.com/docs/models (placeholder below).
APP_OPENAI_MODEL=<openai-model-id>
# The SDKs read their keys from these standard variables:
# ANTHROPIC_API_KEY=...   OPENAI_API_KEY=...
APP_MIN_RELEVANCE=0.5
APP_APPROVAL_THRESHOLD_CENTS=5000
APP_MAX_REFUND_CENTS=50000
APP_AGENT_MAX_TURNS=6
APP_AGENT_TIMEOUT_S=30
# Demo tokens (dev only): token:user_id:role, comma separated.
# Unset = dev defaults: t-alice, t-bob (customers), t-sam, t-pat (agents)
# APP_DEMO_TOKENS=t-alice:alice:customer,t-sam:sam:agent,t-pat:pat:agent
