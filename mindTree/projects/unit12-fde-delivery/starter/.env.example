# Copy to .env for local development. No secrets are needed for the
# fake extractor. A real LLM adapter (Unit 9) would read its API key
# from a secret manager or APP_LLM_API_KEY, never from this file.
APP_ENV=dev
# Auto-accept only when every required field reaches this confidence.
APP_AUTO_ACCEPT_THRESHOLD=0.85
# Ask the LLM for every field so it can cross-check the regexes.
# false = only ask for fields the deterministic pass did not find.
APP_LLM_CROSS_CHECK=true
APP_EXTRACTOR=fake
